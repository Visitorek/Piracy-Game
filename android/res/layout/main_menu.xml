<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/menuBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/menu_background_2" />

    <com.corsair.deluxe.android.CurvedTitleView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:layout_margin="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="210dp"
        android:layout_marginTop="140dp"
        android:layout_marginBottom="0dp"
        android:orientation="vertical"
        android:gravity="center">

            <Button
                android:id="@+id/startGameButton"
                android:layout_width="220dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:background="@drawable/menu_button_bg"
                android:text="@string/start_game"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp" />

            <Button
                android:id="@+id/optionsButton"
                android:layout_width="220dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:background="@drawable/menu_button_bg"
                android:text="@string/options"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp" />

            <Button
                android:id="@+id/infoButton"
                android:layout_width="220dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:background="@drawable/menu_button_bg"
                android:text="@string/info"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp" />

            <Button
                android:id="@+id/exitGameButton"
                android:layout_width="220dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:background="@drawable/menu_button_bg"
                android:text="@string/exit_game"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/versionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="12dp"
        android:text="@string/version_label"
        android:textColor="#FFFFF6DC"
        android:shadowColor="#FF000000"
        android:shadowDx="1.5"
        android:shadowDy="1.5"
        android:shadowRadius="4"
        android:textSize="14sp"
        android:textStyle="bold"
        android:typeface="serif" />

    <LinearLayout
        android:id="@+id/optionsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/options_panel_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/options"
                android:textColor="#F7D98B"
                android:textSize="26sp"
                android:textStyle="bold"
                android:typeface="serif" />

            <Button
                android:id="@+id/optionSoundButton"
                android:layout_width="300dp"
                android:layout_height="42dp"
                android:layout_margin="3dp"
                android:background="@drawable/menu_button_bg"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                tools:text="Dźwięk: WŁ." />

            <Button
                android:id="@+id/optionMusicButton"
                android:layout_width="300dp"
                android:layout_height="42dp"
                android:layout_margin="3dp"
                android:background="@drawable/menu_button_bg"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                tools:text="Muzyka: WŁ." />

            <Button
                android:id="@+id/optionDifficultyButton"
                android:layout_width="300dp"
                android:layout_height="42dp"
                android:layout_margin="3dp"
                android:background="@drawable/menu_button_bg"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                tools:text="Poziom trudności: Normalny" />

            <Button
                android:id="@+id/optionDebugButton"
                android:layout_width="300dp"
                android:layout_height="42dp"
                android:layout_margin="3dp"
                android:background="@drawable/menu_button_bg"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                tools:text="Debug mode: WŁ." />

            <Button
                android:id="@+id/optionCloseButton"
                android:layout_width="220dp"
                android:layout_height="42dp"
                android:layout_margin="8dp"
                android:background="@drawable/menu_button_bg"
                android:text="@string/options_close"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
