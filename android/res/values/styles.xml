<resources>
    <style name="mainTheme" parent="android:Theme.Material.Light.NoActionBar.Fullscreen">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="mainTheme.NoPreview" parent="android:Theme.Material.Light.NoActionBar.Fullscreen">
